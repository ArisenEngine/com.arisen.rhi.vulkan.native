      "3rdparty/vulkan/Layers/VkLayer_crash_diagnostic.dll",
      "3rdparty/vulkan/Layers/VkLayer_crash_diagnostic.json",
      "3rdparty/vulkan/Layers/VkLayer_khronos_synchronization2.dll",
      "3rdparty/vulkan/Layers/VkLayer_khronos_synchronization2.json"
    ]
  }
}
